    {
      "id": "why-sfn",
      "type": "text",
      "x": 0,
      "y": 380,
      "width": 350,
      "height": 100,
      "text": "DESIGN CHOICE: Step Functions\n- Decouples logic from compute\n- Ensures Dim merges finish before Fact loads\n- Native retry handling for transient API errors",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#7950f2"
    },
    {
      "id": "why-scd",
      "type": "text",
      "x": 400,
      "y": 380,
      "width": 350,
      "height": 100,
      "text": "DESIGN CHOICE: SCD Type 2\n- Preserves full history of customer/product edits\n- Critical for 'Point-in-Time' business analytics\n- Implemented via Redshift Stored Procedures",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#1971c2"
    },
    {
      "id": "why-security",
      "type": "text",
      "x": 800,
      "y": 380,
      "width": 350,
      "height": 100,
      "text": "SECURITY MODEL: Surgical Policy\n- Least Privilege: Services restricted by S3 prefix\n- Zero hardcoded secrets (Secrets Manager)\n- Regional Service Principals enforced",
      "fontSize": 14,
      "fontFamily": 1,
      "strokeColor": "#2f9e44"
    }
