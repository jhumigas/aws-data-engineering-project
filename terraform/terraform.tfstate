            "creation_date": "2026-04-19T01:43:31Z",
            "definition": "{\"Comment\":\"Orchestrate Glue Discovery, Transform, and Redshift Load\",\"StartAt\":\"StartCrawlers\",\"States\":{\"MergeCustomerDim\":{\"Next\":\"MergeProductDim\",\"Parameters\":{\"ClusterIdentifier\":\"aws-de-project-dev-redshift\",\"Database\":\"dev\",\"DbUser\":\"adminuser\",\"Sql\":\"CALL sales.sp_merge_dim_customer();\"},\"Resource\":\"arn:aws:states:::aws-sdk:redshiftdata:executeStatement\",\"Type\":\"Task\"},\"MergeProductDim\":{\"End\":true,\"Parameters\":{\"ClusterIdentifier\":\"aws-de-project-dev-redshift\",\"Database\":\"dev\",\"DbUser\":\"adminuser\",\"Sql\":\"CALL sales.sp_merge_dim_product();\"},\"Resource\":\"arn:aws:states:::aws-sdk:redshiftdata:executeStatement\",\"Type\":\"Task\"},\"RunLoadJobs\":{\"Branches\":[{\"StartAt\":\"Job_aws-de-project-dev-load_processed_customers_job\",\"States\":{\"Job_aws-de-project-dev-load_processed_customers_job\":{\"End\":true,\"Parameters\":{\"JobName\":\"aws-de-project-dev-load_processed_customers_job\"},\"Resource\":\"arn:aws:states:::glue:startJobRun.sync\",\"Type\":\"Task\"}}},{\"StartAt\":\"Job_aws-de-project-dev-load_processed_orderdetails_job\",\"States\":{\"Job_aws-de-project-dev-load_processed_orderdetails_job\":{\"End\":true,\"Parameters\":{\"JobName\":\"aws-de-project-dev-load_processed_orderdetails_job\"},\"Resource\":\"arn:aws:states:::glue:startJobRun.sync\",\"Type\":\"Task\"}}},{\"StartAt\":\"Job_aws-de-project-dev-load_processed_orders_job\",\"States\":{\"Job_aws-de-project-dev-load_processed_orders_job\":{\"End\":true,\"Parameters\":{\"JobName\":\"aws-de-project-dev-load_processed_orders_job\"},\"Resource\":\"arn:aws:states:::glue:startJobRun.sync\",\"Type\":\"Task\"}}},{\"StartAt\":\"Job_aws-de-project-dev-load_processed_products\",\"States\":{\"Job_aws-de-project-dev-load_processed_products\":{\"End\":true,\"Parameters\":{\"JobName\":\"aws-de-project-dev-load_processed_products\"},\"Resource\":\"arn:aws:states:::glue:startJobRun.sync\",\"Type\":\"Task\"}}}],\"Next\":\"MergeCustomerDim\",\"Type\":\"Parallel\"},\"RunTransformJobs\":{\"Branches\":[{\"StartAt\":\"Job_aws-de-project-dev-raw_customer_etl_job\",\"States\":{\"Job_aws-de-project-dev-raw_customer_etl_job\":{\"End\":true,\"Parameters\":{\"JobName\":\"aws-de-project-dev-raw_customer_etl_job\"},\"Resource\":\"arn:aws:states:::glue:startJobRun.sync\",\"Type\":\"Task\"}}},{\"StartAt\":\"Job_aws-de-project-dev-raw_orderdetails_etl_job\",\"States\":{\"Job_aws-de-project-dev-raw_orderdetails_etl_job\":{\"End\":true,\"Parameters\":{\"JobName\":\"aws-de-project-dev-raw_orderdetails_etl_job\"},\"Resource\":\"arn:aws:states:::glue:startJobRun.sync\",\"Type\":\"Task\"}}},{\"StartAt\":\"Job_aws-de-project-dev-raw_orders_etl_job\",\"States\":{\"Job_aws-de-project-dev-raw_orders_etl_job\":{\"End\":true,\"Parameters\":{\"JobName\":\"aws-de-project-dev-raw_orders_etl_job\"},\"Resource\":\"arn:aws:states:::glue:startJobRun.sync\",\"Type\":\"Task\"}}},{\"StartAt\":\"Job_aws-de-project-dev-raw_product_etl_job\",\"States\":{\"Job_aws-de-project-dev-raw_product_etl_job\":{\"End\":true,\"Parameters\":{\"JobName\":\"aws-de-project-dev-raw_product_etl_job\"},\"Resource\":\"arn:aws:states:::glue:startJobRun.sync\",\"Type\":\"Task\"}}}],\"Next\":\"RunLoadJobs\",\"Type\":\"Parallel\"},\"StartCrawlers\":{\"Branches\":[{\"StartAt\":\"Run_aws-de-project-dev-crawler-Customer\",\"States\":{\"Run_aws-de-project-dev-crawler-Customer\":{\"End\":true,\"Parameters\":{\"Name\":\"aws-de-project-dev-crawler-Customer\"},\"Resource\":\"arn:aws:states:::aws-sdk:glue:startCrawler\",\"Type\":\"Task\"}}},{\"StartAt\":\"Run_aws-de-project-dev-crawler-Orders\",\"States\":{\"Run_aws-de-project-dev-crawler-Orders\":{\"End\":true,\"Parameters\":{\"Name\":\"aws-de-project-dev-crawler-Orders\"},\"Resource\":\"arn:aws:states:::aws-sdk:glue:startCrawler\",\"Type\":\"Task\"}}},{\"StartAt\":\"Run_aws-de-project-dev-crawler-Product\",\"States\":{\"Run_aws-de-project-dev-crawler-Product\":{\"End\":true,\"Parameters\":{\"Name\":\"